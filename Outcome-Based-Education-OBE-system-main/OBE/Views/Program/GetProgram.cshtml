@model IEnumerable<OBE.Models.Program>

@{
    ViewData["Title"] = "Program";
    ViewData["Description"] = "Manage Programs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Programs</title>
    <style>
        /* نفس التصميم السابق */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f3f0;
            padding: 40px 20px;
            direction: ltr;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .header {
            background: linear-gradient(135deg, #1e3a5f 0%, #2d5a7b 100%);
            padding: 40px;
            color: white;
        }

            .header h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
                font-family: 'Playfair Display', serif;
            }

            .header p {
                font-size: 1rem;
                opacity: 0.9;
            }

        .content {
            padding: 40px;
        }

        .actions-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .search-box {
            display: flex;
            gap: 10px;
            flex: 1;
            min-width: 250px;
        }

            .search-box input {
                flex: 1;
                padding: 12px 16px;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 0.95rem;
                transition: border-color 0.3s;
            }

                .search-box input:focus {
                    outline: none;
                    border-color: #2d5a7b;
                }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 4px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #e85d75 0%, #d14361 100%);
            color: white;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(225, 93, 117, 0.4);
            }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

            .btn-secondary:hover {
                background: #5a6268;
            }

        .btn-small {
            padding: 8px 16px;
            font-size: 0.85rem;
            margin: 0 4px;
        }

        .btn-edit {
            background: #2d5a7b;
            color: white;
        }

            .btn-edit:hover {
                background: #1e3a5f;
            }

        .btn-delete {
            background: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background: #c82333;
            }

        .table-container {
            overflow-x: auto;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        thead {
            background: #f8f9fa;
        }

        th {
            padding: 16px;
            text-align: left;
            font-weight: 600;
            color: #1e3a5f;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #dee2e6;
        }

        td {
            padding: 16px;
            border-bottom: 1px solid #e9ecef;
            color: #495057;
            font-size: 0.95rem;
        }

        tbody tr:hover {
            background-color: #f8f9fa;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
        }

            .modal.active {
                display: flex;
            }

        .modal-content {
            background: white;
            border-radius: 8px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            animation: slideIn 0.3s;
        }

        .modal-header {
            background: linear-gradient(135deg, #1e3a5f 0%, #2d5a7b 100%);
            padding: 30px;
            color: white;
        }

            .modal-header h2 {
                font-size: 1.8rem;
                font-weight: 700;
            }

        .modal-body {
            padding: 30px;
        }

        .form-group {
            margin-bottom: 24px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                color: #1e3a5f;
                font-weight: 600;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

                .form-group label .required {
                    color: #e85d75;
                    margin-left: 4px;
                }

            .form-group input, .form-group select {
                width: 100%;
                padding: 12px 16px;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 0.95rem;
                transition: border-color 0.3s;
                font-family: inherit;
            }

                .form-group input:focus, .form-group select:focus {
                    outline: none;
                    border-color: #2d5a7b;
                }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .modal-footer {
            padding: 20px 30px;
            border-top: 1px solid #e9ecef;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .stats-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 20px;
            border-radius: 6px;
            border-left: 4px solid #2d5a7b;
        }

            .stat-card h3 {
                color: #1e3a5f;
                font-size: 2rem;
                font-weight: 700;
                margin-bottom: 5px;
            }

            .stat-card p {
                color: #6c757d;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @@media (max-width: 768px) {
            .actions-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Manage Programs</h1>
            <p>Admin Control Panel</p>
        </div>

        <div class="content">
            <div class="stats-cards">
                <div class="stat-card">
                    <h3 id="totalPrograms">0</h3>
                    <p>Total Programs</p>
                </div>
                <div class="stat-card">
                    <h3 id="activePrograms">0</h3>
                    <p>Active Programs</p>
                </div>
                <div class="stat-card">
                    <h3 id="inactivePrograms">0</h3>
                    <p>Inactive Programs</p>
                </div>
            </div>

            <div class="actions-bar">
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Search programs...">
                </div>
                <button class="btn btn-primary" onclick="openModal('add')">+ Add New Program</button>
            </div>

            <div class="table-container">
                <table id="programsTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Code</th>
                            <th>Name (English)</th>
                            <th>Name (Arabic)</th>
                            <th>Created At</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="programsTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal" id="programModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Add New Program</h2>
            </div>
            <div class="modal-body">
                <form id="programForm">
                    <input type="hidden" id="programId">

                    <div class="form-group">
                        <label>Code <span class="required">*</span></label>
                        <input type="text" id="programCode" placeholder="e.g., CS-101" required maxlength="50">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Name (English) <span class="required">*</span></label>
                            <input type="text" id="programNameEn" placeholder="Name in English" required maxlength="255">
                        </div>
                        <div class="form-group">
                            <label>Name (Arabic) <span class="required">*</span></label>
                            <input type="text" id="programNameAr" placeholder="الاسم بالعربية" required dir="rtl" maxlength="255">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Is Active <span class="required">*</span></label>
                        <select id="isActive" required>
                            <option value="true">True</option>
                            <option value="false">False</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button class="btn btn-primary" onclick="saveProgram()">Save Program</button>
            </div>
        </div>
    </div>

    <script>
        // 1. Load Data from Server
        let programs = @Html.Raw(Json.Serialize(Model));

        let currentEditId = null;
        let modalMode = 'add'; // 'add' or 'edit'

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            renderTable();
            updateStats();
            setupSearch();
        });

        function updateStats() {
            const total = programs.length;
            const active = programs.filter(p => p.isActive).length;
            const inactive = total - active;
            document.getElementById('totalPrograms').textContent = total;
            document.getElementById('activePrograms').textContent = active;
            document.getElementById('inactivePrograms').textContent = inactive;
        }

        // ===========================================
        // 2. Open Modal (Updated for Edit)
        // ===========================================
        function openModal(mode, id = null) {
            modalMode = mode;
            currentEditId = id;
            const modal = document.getElementById('programModal');
            const modalTitle = document.getElementById('modalTitle');
            const form = document.getElementById('programForm');

            // Reset Form First
            form.reset();

            if (mode === 'add') {
                modalTitle.textContent = 'Add New Program';
                document.getElementById('programId').value = '';
                // Default to true for new
                document.getElementById('isActive').value = 'true';
            } else {
                modalTitle.textContent = 'Edit Program';

                // Find and populate data
                const program = programs.find(p => p.id === id);
                if(program) {
                    document.getElementById('programId').value = program.id;
                    document.getElementById('programCode').value = program.code;
                    document.getElementById('programNameEn').value = program.nameEn;
                    document.getElementById('programNameAr').value = program.nameAr;
                    document.getElementById('isActive').value = program.isActive.toString().toLowerCase(); // "true" or "false"
                }
            }
            modal.classList.add('active');
        }

        function closeModal() {
            document.getElementById('programModal').classList.remove('active');
        }

        function formatDate(dateString) {
            if(!dateString) return "";
            const d = new Date(dateString);
            return d.toLocaleDateString();
        }

        // ===========================================
        // 3. Save Function (Handles Add & Edit)
        // ===========================================
        async function saveProgram() {
            const id = document.getElementById('programId').value;
            const code = document.getElementById('programCode').value;
            const nameEn = document.getElementById('programNameEn').value;
            const nameAr = document.getElementById('programNameAr').value;
            const isActive = document.getElementById('isActive').value;

            if (!code || !nameEn || !nameAr) {
                alert('Please fill in all required fields');
                return;
            }

            const formData = new FormData();
            formData.append('code', code);
            formData.append('NameEn', nameEn);
            formData.append('NameAr', nameAr);
            formData.append('isActive', isActive);

            // If Edit mode, append ID and set correct URL
            if(modalMode === 'edit') {
                formData.append('id', id);
            }

            // ملاحظة: تأكد أن اسم الكنترولر في الرابط (Program أو Programs) يطابق مشروعك
            const url = modalMode === 'add'
                ? '/Program/CreateProgram'
                : '/Program/EditProgram';

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const savedData = await response.json();
                    alert(modalMode === 'add' ? 'Added Successfully!' : 'Updated Successfully!');

                    // Reload page to reflect changes
                    window.location.reload();
                } else {
                    const errorText = await response.text();
                    alert('Error from server: ' + errorText);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Connection Failed');
            }
        }

               async function deleteProgram(id) {
            if (confirm(`Are you sure you want to delete this program?`)) {
                try {
                    // 1. إرسال طلب الحذف للسيرفر
                    // نستخدم FormData لإرسال الـ ID بشكل آمن وسهل
                    const formData = new FormData();
                    formData.append('id', id);

                    const response = await fetch(`/Program/DeleteProgram`, {
                        method: 'POST',
                        body: formData
                    });

                    // 2. التحقق من النتيجة
                    if (response.ok) {
                        alert('Deleted Successfully!'); // رسالة نجاح
                        window.location.reload();       // تحديث الصفحة لإخفاء السطر المحذوف
                    } else {
                        alert('Failed to delete. Try again.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Connection Failed');
                }
            }
        }

        function renderTable(filteredPrograms = programs) {
            const tbody = document.getElementById('programsTableBody');
            tbody.innerHTML = '';

            if (filteredPrograms.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="empty-state">No Programs Found</td></tr>`;
                return;
            }

            filteredPrograms.forEach((program) => {
                const statusClass = program.isActive ? 'status-active' : 'status-inactive';
                const statusText = program.isActive ? 'True' : 'False';
                const dateDisplay = formatDate(program.createdAt);

                const row = `
                    <tr>
                        <td>${program.id}</td>
                        <td>${program.code}</td>
                        <td>${program.nameEn}</td>
                        <td>${program.nameAr}</td>
                        <td>${dateDisplay}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                        <td>
                            <button class="btn btn-small btn-edit" onclick="openModal('edit', ${program.id})">Edit</button>
                            <button class="btn btn-small btn-delete" onclick="deleteProgram(${program.id})">Delete</button>
                        </td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }

        function setupSearch() {
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('input', (e) => {
                const searchTerm = e.target.value.toLowerCase();
                const filtered = programs.filter(program =>
                    program.id.toString().includes(searchTerm) ||
                    (program.code && program.code.toLowerCase().includes(searchTerm)) ||
                    (program.nameEn && program.nameEn.toLowerCase().includes(searchTerm)) ||
                    (program.nameAr && program.nameAr.includes(searchTerm))
                );
                renderTable(filtered);
            });
        }

        // Close modal utils
        document.getElementById('programModal').addEventListener('click', (e) => {
            if (e.target.id === 'programModal') closeModal();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    </script>
</body>
</html>